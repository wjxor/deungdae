# 등대 환경변수 예시
# 이 파일을 .env로 복사해서 값을 채운다. 실제 값은 팀 채널로만 공유하고 절대 커밋하지 않는다.

# ── 서버 (apps/api) ─────────────────────────────
# 카카오 REST API 키 — 도보 경로·장소 검색용. 서버에서만 사용 (클라이언트 번들 노출 금지)
KAKAO_REST_API_KEY=

# Supabase PostgreSQL 접속 문자열 (Prisma)
DATABASE_URL=
# Prisma 마이그레이션용 직접 연결 (Supabase 커넥션 풀러를 쓸 경우)
DIRECT_URL=

# 한국천문연구원 출몰시각 API 키 (공공데이터포털 서비스 키) — FR-005
KASI_API_KEY=

PORT=3000

# ── 클라이언트 (apps/web) ───────────────────────
# 카카오 JavaScript 키 — 지도 SDK용. Vite는 VITE_ 접두사가 붙은 값만 클라이언트에 노출한다
VITE_KAKAO_JS_KEY=
# NestJS API 주소
VITE_API_BASE_URL=http://localhost:3000/api
