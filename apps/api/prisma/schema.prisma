// 등대 DB 스키마. docs/ERD.md의 Must 테이블 5개 + users(FR-011, 2026-11-12 카카오 로그인) + 즐겨찾기 2개(FR-012, 2026-11-22) + reports(FR-009, 2026-11-23)
// 테이블·컬럼은 snake_case, 모델·필드는 PascalCase·camelCase (@@map·@map)
// DB 접속 주소는 이 파일이 아니라 prisma.config.ts에 있다 (Prisma 7)

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// 시설 종류와 안전점수 가중치. 가중치를 코드가 아니라 테이블에 둬서 배포 없이 조정한다
model FacilityType {
  code   String @id // street_light, security_light, cctv, emergency_bell, police
  name   String
  weight Float // 한 곳당 가중치. 가로등·보안등을 1로 맞춘 배수 — 설문 AHP 비율 (ROADMAP "결정된 것" 시설 가중치, PR #84·#86)

  dataSources DataSource[]
  facilities  Facility[]

  @@map("facility_types")
}

// 원본 데이터 출처·적재 이력. 적재할 때마다 한 행
model DataSource {
  id           Int       @id @default(autoincrement())
  facilityType String    @map("facility_type")
  title        String
  sourceUrl    String?   @map("source_url")
  baseDate     DateTime? @map("base_date") @db.Date
  rawCount     Int       @map("raw_count")
  loadedCount  Int       @map("loaded_count")
  note         String?
  importedAt   DateTime  @default(now()) @map("imported_at") @db.Timestamptz

  type       FacilityType @relation(fields: [facilityType], references: [code])
  facilities Facility[]

  @@map("data_sources")
}

// 안전시설 5종을 한 테이블에 둔다. 위치는 PostGIS geography라 Prisma Client로는 읽고 쓰지 못하고 $queryRaw로 다룬다
// district CHECK 제약은 마이그레이션 SQL에 직접 넣는다 (ERD "Prisma·PostGIS 메모")
model Facility {
  id           Int                                   @id @default(autoincrement())
  type         String
  dataSourceId Int                                   @map("data_source_id")
  sourceKey    String?                               @map("source_key")
  name         String?
  address      String?
  district     String?
  location     Unsupported("geography(Point, 4326)")
  coordSource  String                                @default("original") @map("coord_source")
  attributes   Json                                  @default("{}")
  createdAt    DateTime                              @default(now()) @map("created_at") @db.Timestamptz

  facilityType FacilityType @relation(fields: [type], references: [code])
  dataSource   DataSource   @relation(fields: [dataSourceId], references: [id])

  @@index([type])
  @@index([location], type: Gist)
  @@map("facilities")
}

// 경로 API 응답 캐시. 카카오 도보 경로 일 1,000건 무료 한도 때문에 같은 요청은 다시 부르지 않는다
model RouteCache {
  id        Int      @id @default(autoincrement())
  cacheKey  String   @unique @map("cache_key") // provider·route_mode·좌표(소수점 4자리)·경유지의 SHA-256
  provider  String // kakao (티맵 교체 대비)
  routeMode String   @map("route_mode")
  waypoints Json     @default("[]")
  response  Json
  distanceM Int?     @map("distance_m")
  durationS Int?     @map("duration_s")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  expiresAt DateTime @map("expires_at") @db.Timestamptz

  @@map("route_cache")
}

// 일출·일몰 캐시 (FR-005). 천문연 API를 하루 1회 부르고 저장한다
model SunTime {
  date      DateTime @db.Date
  region    String   @default("대전")
  sunrise   DateTime @db.Timestamptz
  sunset    DateTime @db.Timestamptz
  fetchedAt DateTime @default(now()) @map("fetched_at") @db.Timestamptz

  @@id([date, region])
  @@map("sun_times")
}

// 회원 (FR-011). 소셜 로그인만 있어서 비밀번호 컬럼은 두지 않는다 (이메일 가입은 화면이 없어 만들지 않음)
// 사람은 (provider, provider_id)로 구분한다. 닉네임은 겹쳐도 되고 이메일은 서비스마다 같을 수 있어 UNIQUE를 두지 않는다
model User {
  id         Int      @id @default(autoincrement())
  provider   String // kakao (네이버·구글은 나중에 같은 구조로)
  providerId String   @map("provider_id") // 카카오 회원번호. Long이라 JS 숫자로 다루면 끝자리가 틀어질 수 있어 문자열로 둔다
  nickname   String
  email      String? // 카카오는 이메일 동의항목을 받지 않아 늘 null (비즈 앱 전용)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  favoritePlaces FavoritePlace[]
  favoriteRoutes FavoriteRoute[]
  reports        Report[]

  @@unique([provider, providerId])
  @@map("users")
}

// 즐겨찾기 (FR-012, 2026-11-22). 장소 정보는 서버가 AES-256-GCM으로 암호화해 payload에 넣는다 (NFR-004, src/favorites/favorite-crypto.ts).
// 장소 ID에도 주소·좌표가 들어 있어서, 같은 곳을 두 번 저장하지 않게 하는 키는 HMAC(회원 id + 장소 ID) 값이다. 탈퇴하면 같이 지운다
model FavoritePlace {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  placeKey  String   @map("place_key") // HMAC-SHA256(회원id:장소ID) hex
  payload   Bytes // 키 버전(1) + IV(12) + 인증 태그(16) + 암호문. 평문은 Place JSON
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, placeKey])
  @@map("favorite_places")
}

// 경로 즐겨찾기는 출발지·도착지만 저장하고 불러올 때 다시 검색한다 (점수·경로 모양은 시설 데이터·낮밤에 따라 달라져서)
model FavoriteRoute {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  routeKey  String   @map("route_key") // HMAC-SHA256(회원id:출발ID 또는 here>도착ID) hex
  payload   Bytes // 평문은 { name, origin: Place | null, destination: Place } JSON. origin null = "현재 위치"
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, routeKey])
  @@map("favorite_routes")
}

// 위험 제보 (FR-009, 2026-11-23 PR #93). 회원만 쓰고 사진은 받지 않는다.
// 탈퇴하면 제보는 남기고 작성자만 비운다(SET NULL) — 제보가 구간 점수(FR-010)에 들어가서, 지우면 다른 사람이 보는 점수가 바뀐다.
// 위치는 PostGIS geography라 $queryRaw로 쓴다. type·description CHECK는 마이그레이션 SQL에 직접 넣는다
model Report {
  id          Int                                   @id @default(autoincrement())
  userId      Int?                                  @map("user_id")
  location    Unsupported("geography(Point, 4326)")
  type        String // dark, no_cctv, others (shared/types.ts ReportType. 우범지역은 2026-11-23에 뺐다)
  description String? // 200자까지. 빈칸뿐이면 null
  createdAt   DateTime                              @default(now()) @map("created_at") @db.Timestamptz
  user        User?                                 @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([location], type: Gist)
  @@index([createdAt])
  @@map("reports")
}
